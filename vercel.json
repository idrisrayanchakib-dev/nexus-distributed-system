{
  "framework": null,
  "outputDirectory": "website",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/NexusP2P-Windows-x64.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=NexusP2P-Windows-x64.zip"
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/NexusP2P.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=NexusP2P.exe"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.microsoft.portable-executable"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
