{
  "version": 2,
  "outputDirectory": "website",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=NexusP2P-Windows-x64.zip"
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=NexusP2P.exe"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.microsoft.portable-executable"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    }
  ]
}
