{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/website/assets/$1"
    },
    {
      "src": "/NexusP2P-Windows-x64.zip",
      "headers": {
        "Content-Disposition": "attachment; filename=NexusP2P-Windows-x64.zip",
        "Content-Type": "application/zip",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/website/NexusP2P-Windows-x64.zip"
    },
    {
      "src": "/NexusP2P.exe",
      "headers": {
        "Content-Disposition": "attachment; filename=NexusP2P.exe",
        "Content-Type": "application/vnd.microsoft.portable-executable",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/website/NexusP2P.exe"
    },
    {
      "src": "/styles.css",
      "dest": "/website/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/website/app.js"
    },
    {
      "src": "/",
      "dest": "/website/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/website/$1"
    }
  ]
}
